---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games.filter((game) => game.category).map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games.filter((game) => game.publisher).map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters" aria-label="Filter games">
          <div class="grid gap-6 md:grid-cols-2">
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-200">Categories</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      data-testid={`category-filter-${category.id}`}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <div>
              <label for="publisher-filter" class="mb-3 block text-sm font-semibold text-slate-200">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                data-testid="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>
          </div>
          <button
            type="reset"
            data-testid="clear-filters"
            class="mt-6 rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear filters
          </button>
          <p class="mt-4 text-sm text-slate-400" data-testid="filter-result-count" aria-live="polite"></p>
        </form>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filter-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');

  if (form && grid && emptyState && resultCount) {
    const updateResults = (): void => {
      const selectedCategories = new Set(
        [...form.querySelectorAll<HTMLInputElement>('input[name="category"]:checked')].map((input) => input.value),
      );
      const selectedPublisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]')?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        visibleCount += visible ? 1 : 0;
      });

      grid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'game' : 'games'} shown`;
    };

    form.addEventListener('change', updateResults);
    form.addEventListener('reset', () => requestAnimationFrame(updateResults));
    updateResults();
  }
</script>
